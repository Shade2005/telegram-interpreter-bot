# Telegram Bot Configuration
# Obtain your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Configurations
# Model to use: gemini-2.5-flash (default per requirement), or gemini-3.8-flash
GEMINI_MODEL=gemini-2.5-flash

# Gulf Arabic TTS Voice (edge-tts):
# Options: ar-AE-HamdanNeural (UAE Male), ar-SA-HamedNeural (Saudi Male), ar-AE-FatimaNeural (UAE Female), ar-SA-ZariyahNeural (Saudi Female)
EDGE_TTS_VOICE=ar-AE-HamdanNeural
